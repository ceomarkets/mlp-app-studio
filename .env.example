# Copia este archivo como .env.local
# Sin estas variables la app arranca en MODO DEMO (datos locales en el navegador).
# En Lovable Cloud se inyectan solas al activar la base de datos.
VITE_SUPABASE_URL=https://<tu-proyecto>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon/publishable key>

# Secretos de las funciones de Supabase (NO van en el frontend).
# Configúralos en Supabase → Edge Functions → Secrets (o en Lovable → Cloud → Secrets):
#   WOMPI_PUBLIC_KEY=pub_test_...        (pub_prod_... en producción)
#   WOMPI_INTEGRITY_SECRET=test_integrity_...
#   WOMPI_EVENTS_SECRET=test_events_...
